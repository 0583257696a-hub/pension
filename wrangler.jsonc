{
  // Cloudflare Worker for AI Pension Academy (Next.js via the OpenNext adapter).
  // The worker name must match the Worker connected to this repository in the Cloudflare dashboard.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pension",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // `wrangler deploy` (the default Workers Builds deploy command) runs this build first, so the
  // deploy works whatever build command is set in the dashboard. The OpenNext config lives in
  // cloudflare/ on purpose: with it in the project root, Wrangler would hand the deploy to
  // `opennextjs-cloudflare deploy`, which skips this build step.
  "build": {
    "command": "npx opennextjs-cloudflare build --openNextConfigPath cloudflare/open-next.config.ts"
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "pension" }
  ],
  // The database and bucket are created automatically on the first deploy if they do not exist.
  "d1_databases": [
    { "binding": "ACADEMY_DB", "database_name": "pension-academy" }
  ],
  "r2_buckets": [
    { "binding": "ACADEMY_MEDIA", "bucket_name": "pension-academy-media" }
  ],
  "observability": { "enabled": true }
}
