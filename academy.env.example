# AI Pension Academy — environment variables (copy the ones you need into .env.local)
# Nothing here is required for local development: SQLite + local files + manual NotebookLM mode.

# --- Database -------------------------------------------------------------
# sqlite (default) | d1-http (Cloudflare D1 via REST, works on any host) | d1-binding (app runs on Cloudflare)
ACADEMY_DB_DRIVER=sqlite
ACADEMY_SQLITE_FILE=.data/academy.sqlite
CF_ACCOUNT_ID=
CF_D1_DATABASE_ID=
CF_API_TOKEN=            # token with D1 edit permission (server-side only)

# --- File storage (videos) ------------------------------------------------
# local (default) | r2
ACADEMY_STORAGE_DRIVER=local
ACADEMY_UPLOAD_DIR=.data/uploads
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Claude (AI tutor + content engine) -----------------------------------
ANTHROPIC_API_KEY=
ACADEMY_CLAUDE_MODEL=claude-opus-5-5
ACADEMY_TUTOR_EFFORT=medium     # low | medium | high

# --- NotebookLM (Gemini Notebook Enterprise API, v1alpha) -----------------
# Leave NOTEBOOKLM_PROJECT_NUMBER empty for the manual workflow.
NOTEBOOKLM_PROJECT_NUMBER=
NOTEBOOKLM_LOCATION=global               # global | us | eu
NOTEBOOKLM_ENDPOINT_LOCATION=            # e.g. "us-" or "discoveryengine.us.rep.googleapis.com"
NOTEBOOKLM_OAUTH_CLIENT_ID=
NOTEBOOKLM_OAUTH_CLIENT_SECRET=
NOTEBOOKLM_OAUTH_REFRESH_TOKEN=          # user with a Gemini Notebook Enterprise license
NOTEBOOKLM_ACCESS_TOKEN=                 # development only: `gcloud auth print-access-token`
NOTEBOOKLM_WEB_URL_TEMPLATE=             # optional, e.g. https://notebooklm.cloud.google.com/{location}/notebook/{notebookId}?project={projectNumber}

# --- Payments ---------------------------------------------------------------
# "none" until a verified PSP is integrated (see ACADEMY.md). No simulated payments exist.
ACADEMY_PAYMENT_PROVIDER=none

# --- Misc -------------------------------------------------------------------
ACADEMY_APP_URL=http://localhost:3000
ACADEMY_SESSION_DAYS=30
ACADEMY_BOOTSTRAP_ADMIN_EMAIL=           # this email becomes admin on registration (the first user always does)
ACADEMY_RENDER_TOKEN=                    # lets scripts/render-calculator-video.mjs open /render/calculator/*
